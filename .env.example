# Generate the two tokens with scripts/generate-env.py.
NTFY_API_TOKEN=
NTFY_UI_TOKEN=
# Generate with `caddy hash-password`; single-quote the hash in .env.
ADMIN_PASSWORD_HASH=
NTFY_SOURCE_HOST=ntfy.example.org
NTFY_SOURCE_USER=ntfy-reader
NTFY_SOURCE_PORT=22
NTFY_BASE_URL=https://ntfy.example.org
# Exact browser origin(s), separated by commas, without trailing slashes.
NTFY_UI_ORIGINS=http://localhost:8080
